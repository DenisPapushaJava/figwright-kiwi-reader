{
  "manifest_version": 3,
  "name": "Figwright Kiwi Reader",
  "version": "0.2.0",
  "description": "Read-only capture of the Figma scenegraph already delivered to this browser tab.",
  "permissions": ["activeTab", "debugger", "tabs"],
  "host_permissions": ["https://www.figma.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Figwright Kiwi Reader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
