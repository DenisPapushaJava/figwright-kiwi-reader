{
  "manifest_version": 3,
  "name": "FigLens",
  "version": "0.5.0",
  "key": "",
  "minimum_chrome_version": "116",
  "description": "Read-only capture of the Figma scenegraph already delivered to this browser tab.",
  "permissions": ["activeTab", "debugger", "sidePanel", "storage", "tabs"],
  "host_permissions": ["https://www.figma.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FigLens",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "32": "icons/toolbar-32.png"
    }
  }
}
